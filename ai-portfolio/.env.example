# Groq API Key (Get a free API key at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Groq Model Identifier
# Recommended: openai/gpt-oss-120b or llama-3.3-70b-versatile or llama-3.1-8b-instant
GROQ_MODEL=openai/gpt-oss-120b

# Admin Secret Password for uploading and managing resumes via /admin
ADMIN_PASSWORD=your_secure_admin_password_here

# Default Candidate Name displayed before a resume is uploaded
DEFAULT_NAME=Harshal
